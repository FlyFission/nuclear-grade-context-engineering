{
  "version": 1,
  "default": "none",
  "records_root": ".nuclear/changes",
  "record_edit_mode": "quick",
  "record_delete_mode": "standard",
  "bot_identities": [],
  "dependency_lane": {"authors": ["dependabot[bot]"], "paths": [".github/workflows/**", "pyproject.toml"]},
  "rules": [
    {"id": "agent-instructions", "mode": "quick", "paths": ["AGENTS.md", "**/AGENTS.md", "CLAUDE.md", "**/CLAUDE.md", "CORE.md", "MAXIMS.md"], "reason": "always-loaded agent instructions"},
    {"id": "claims", "mode": "quick", "paths": ["**.md"], "exclude": [".nuclear/**", "**/.nuclear/**", "CHANGELOG.md", "commands/**"], "claims": "general", "reason": "claim-bearing public wording"},
    {"id": "assurance-claims", "mode": "standard", "paths": ["**.md"], "exclude": [".nuclear/**", "**/.nuclear/**", "CHANGELOG.md", "commands/**"], "claims": "assurance", "reason": "assurance or compliance wording", "skills": ["checking-legal-and-safety-wording"]},
    {"id": "efficacy-claims", "mode": "standard", "paths": ["**.md"], "exclude": [".nuclear/**", "**/.nuclear/**", "CHANGELOG.md", "commands/**"], "claims": "efficacy", "reason": "efficacy numbers", "skills": ["proving-claims", "checking-source-claims"]},
    {"id": "trust-tests", "mode": "standard", "paths": ["tests/test_pre_tool_use_hook.py", "tests/test_hooks.py", "tests/test_ng_validate.py", "tests/test_two_party.py", "tests/test_review_run.py", "tests/test_consequence.py", "tests/test_challenge.py", "tests/test_challenge_results.py", "tests/test_public_docs.py", "tests/test_globmatch.py", "tests/test_receipt.py", "tests/test_propagation.py", "tests/test_acceptance_adversarial.py", "tests/test_release.py", "tests/test_badge.py", "tests/test_mcp_server.py", "tests/test_repo_policy.py", "tests/test_plugin_packaging.py"], "reason": "tests that guard trust surfaces"},
    {"id": "mode-owners", "mode": "standard", "paths": ["skills/using-nuclear-grade/**", "skills/rating-change-risk/**"], "reason": "the prompts that set every change's mode"},
    {"id": "validators", "mode": "standard", "paths": ["nuclear_grade/ng_validate.py", "nuclear_grade/two_party.py", "nuclear_grade/review_run.py", "nuclear_grade/receipt.py", "nuclear_grade/propagation.py", "nuclear_grade/consequence.py", "nuclear_grade/globmatch.py", "nuclear_grade/release.py", "nuclear_grade/badge.py", "nuclear_grade/mcp_server.py", "tools/ng.py", "tools/ng_validate.py", "challenge/score.py", "challenge/judge/**", "challenge-results/*.py", "challenge-results/adjudications.json", "challenge-results/agents.json"], "reason": "checkers, scorer, and agent-callable tools"},
    {"id": "gate-cli", "mode": "standard", "paths": ["nuclear_grade/cli.py"], "content": "\\b(consequence|validate_packet|required_mode|strict_custody|strict_authority|require_custody|require_authority|advisory)\\b", "reason": "CLI lines that wire the validator or the required-mode gate"},
    {"id": "deps-release", "mode": "standard", "paths": ["pyproject.toml", "**requirements*.txt", "CITATION.cff", ".claude-plugin/**", "plugins/*/.claude-plugin/**", ".codex-plugin/**", "install.sh", "tools/install-codex.py"], "reason": "dependencies, release identity, install vehicle", "skills": ["vetting-outside-code-and-models"]},
    {"id": "model-id", "mode": "standard", "paths": ["nuclear_grade/**", "tools/**", "hooks/**", "challenge/**"], "content": "\\b(claude-[a-z0-9.-]+|gpt-[0-9][\\w.-]*|gemini-[\\w.-]+)\\b", "reason": "model id in executable code"},
    {"id": "ci", "mode": "standard+authority", "paths": [".github/**"], "overridable": false, "reason": "CI is the out-of-band gate", "skills": ["declaring-intent", "deciding-who-decides"]},
    {"id": "gate", "mode": "standard+authority", "paths": ["hooks/**", "plugins/*/hooks/**", ".claude/**", ".nuclear/gate-policy.json", ".nuclear/charter.md"], "overridable": false, "reason": "the in-session gate and charter", "skills": ["declaring-intent", "deciding-who-decides", "stress-testing-agent-changes"]}
  ]
}
